---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { withBase } from '../lib/paths';
import '../../design/tokens.css';
import '../styles/global.css';
import '../styles/blog.css';
import Search from '../components/Search.astro';
interface Props { title?: string; description?: string; active?: 'home' | 'projects' | 'about' | 'archive'; noindex?: boolean; mode?: 'standard' | 'index' | 'reader' }
const { title, description = site.description, active = 'home', noindex = site.profilePending, mode = 'standard' } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · 个人博客`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F7F5" />
    {(noindex || site.profilePending) && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
  </head>
  <body id="top" class:list={['blog-mode', `layout-${mode}`]}>
    <a class="skip-link" href="#main">跳转到内容</a>
    <slot name="welcome" />
    <Header active={active} />
    <slot name="rail" />
    <main id="main" tabindex="-1" class:list={[{ 'blog-shell': mode !== 'standard' }]}><slot /></main>
    <Footer showWelcome={mode === 'index'} />
    <Search />
    <script>
      import '../scripts/images';
      import '../scripts/blog';
    </script>
  </body>
</html>
