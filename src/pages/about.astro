---
import SiteLayout from '../layouts/SiteLayout.astro';
import Contact from '../components/Contact.astro';
import Artwork from '../components/Artwork.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../config/site';
import { withBase } from '../lib/paths';
---
<SiteLayout title="关于我" active="about">
  <section class="container about-hero">
    <div class="about-heading"><p class="eyebrow">ABOUT / 关于这个博客</p><h1>文字背后，<br />还有一个<span class="editorial-text">我。</span></h1><p class="quiet-note">站名暂定「{site.title}」 · 个人资料待补充</p></div>
    <figure class="portrait"><Artwork src="/images/portrait-placeholder.svg" alt="个人照片占位图，尚未添加真实肖像" width={600} height={800} eager /><figcaption>个人照片待补充</figcaption></figure>
    <div class="about-biography"><p class="eyebrow">你好，我是</p><h2>{site.name}<span class="signature-dot" aria-hidden="true"></span></h2><p>{site.introduction}</p><dl class="bio-facts"><div><dt>专业方向</dt><dd>{site.direction}</dd></div><div><dt>当前关注</dt><dd>待补充</dd></div></dl><a class="text-link" href={withBase('/archive/')}>通过文字认识我 <Arrow /></a></div>
  </section>
  <section class="container about-note section-space" aria-labelledby="note-title"><p class="eyebrow">A PERSONAL NOTE / 一点自述</p><h2 id="note-title" class="editorial-text">认真观察，<br class="mobile-break" />也保持好奇。</h2><p>这里将放入一段真正属于我的话：为什么开始，关心什么，<br class="desktop-break" />以及接下来想尝试的事情。</p><p class="quiet-note">以上为示意文案，待替换为个人自述。</p></section>
  <Contact />
</SiteLayout>
