---
import { render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Artwork from '../../components/Artwork.astro';
import Arrow from '../../components/Arrow.astro';
import { getPosts, columnFor, formatDate, readingMinutes } from '../../lib/posts';
import { withBase } from '../../lib/paths';
export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.data.slug }, props: { post, next: posts[i + 1] ?? posts[0] ?? null } }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post, next } = Astro.props;
const { Content, headings } = await render(post);
const p = post.data;
const column = columnFor(p.category);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---
<SiteLayout title={p.title} description={p.summary} mode="reader" noindex={p.demo}>
  <aside slot="rail" class="blog-rail reading-rail" aria-label="文章目录"><a class="reading-back" href={withBase(`/#${p.category}`)}><Arrow direction="left" />返回{column.title}</a><p class="rail-label">ON THIS PAGE</p><details open><summary>文章目录</summary><nav>{toc.map((h, i) => <a href={`#${h.slug}`} data-section-link={h.slug} class:list={[{ 'is-current': i === 0, 'toc-sub': h.depth === 3 }]} aria-current={i === 0 ? 'location' : undefined}>{h.text}</a>)}</nav></details></aside>
  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
  <article class="reading-article"><header class="post-header"><div><p class="eyebrow">{column.english} / {column.title}</p><h1>{p.title}</h1><p class="post-deck">{p.summary}</p><div class="post-byline"><time datetime={p.date.toISOString()}>{formatDate(p.date)}</time><span>约 {readingMinutes(post)} 分钟</span>{p.demo && <span class="sample-label">示例文章</span>}</div></div><div class="post-header-art"><Artwork src={p.cover} alt={p.coverAlt} eager /></div></header>
    <div class="reading-toolbar"><div class="post-tags">{p.tags.map(tag => <span>#{tag}</span>)}</div><div class="reader-actions"><button type="button" class="bookmark-button" data-bookmark={p.slug} aria-pressed="false"><span data-bookmark-label>稍后读</span><span aria-hidden="true">＋</span></button><button type="button" class="copy-link" data-copy-link>复制链接</button></div></div><p class="reader-status" role="status" aria-live="polite" data-reader-status></p>
    {p.demo && <p class="article-demo-note">这是一篇为博客排版撰写的原创示例，不代表个人经历。日期为示例日期。</p>}
    <div class="prose reading-copy" data-reading-content><Content /></div>
    <footer class="article-end"><span aria-hidden="true"></span><p>谢谢你读到这里。</p><a class="text-link" href={withBase('/archive/')}>浏览全部文章 <Arrow direction="right" /></a></footer>
    {next && next.data.slug !== p.slug && <a class="next-reading" href={withBase(`/posts/${next.data.slug}/`)}><span>接着读 / {columnFor(next.data.category).title}</span><strong>{next.data.title}<Arrow direction="right" /></strong><p>{next.data.summary}</p></a>}
  </article>
</SiteLayout>
