<dialog class="search-dialog" aria-labelledby="search-title" data-search-dialog><div class="search-panel">
  <div class="search-panel-heading"><h2 id="search-title">在此间，找一点想法。</h2><button type="button" class="icon-control" aria-label="关闭搜索" data-search-close><span aria-hidden="true">×</span></button></div>
  <label class="search-label" for="blog-search">搜索标题、正文或标签</label><input id="blog-search" class="blog-search-input" type="search" placeholder="试试「笔记」或「留白」" autocomplete="off" data-search-input />
  <p class="search-status" role="status" aria-live="polite" data-search-status>输入关键词，搜索全站文章。</p>
  <ul class="search-results" data-search-results></ul><button type="button" class="text-link" data-search-retry hidden>重新加载搜索</button>
  <div class="search-help"><span>搜索全站文章</span><span><kbd>Esc</kbd> 关闭</span></div>
</div></dialog>
