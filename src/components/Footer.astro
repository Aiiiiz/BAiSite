---
import { site, welcome } from '../config/site';
import { withBase } from '../lib/paths';
interface Props { showWelcome?: boolean }
const { showWelcome = false } = Astro.props;
---
<footer class="site-footer blog-footer">
  <div class="container footer-inner">
    <a href={withBase('/')} class="footer-name">{site.title}<span>记录、学习，还有一些未完的想法。</span></a>
    <p>{site.profilePending ? '个人资料待补充 · 当前文章为原创示例' : `© ${new Date().getFullYear()} ${site.name}`}</p>
    <div class="footer-navigation">{showWelcome && welcome.enabled && <button type="button" class="welcome-reopen" data-welcome-open hidden>重看欢迎页</button>}<a href="#top" class="back-top">回到顶部 <span aria-hidden="true">↑</span></a></div>
  </div>
</footer>
